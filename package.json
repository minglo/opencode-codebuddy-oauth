{
  "name": "opencode-codebuddy-oauth",
  "version": "3.1.0",
  "description": "OpenCode plugin for CodeBuddy (IOA) authentication",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "index.js"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm run build"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.2.5"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.2.5",
    "@types/node": "~22.20.5",
    "tsdown": "0.23.4",
    "typescript": "7.0.2",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "opencode",
    "plugin",
    "codebuddy",
    "ioa",
    "authentication"
  ],
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minglo/opencode-codebuddy-oauth.git"
  }
}
